# ==============================================================================
# Enterprise Multimodal RAG & Agentic Knowledge Assistant - Environment Config
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Persistence
# ------------------------------------------------------------------------------
# SQLite is used by default for thread history, episodic memory, and analytics.
# To switch to PostgreSQL in production, set: postgresql://user:password@localhost:5432/rag_db
DATABASE_URL=sqlite:///./app/data/dev.db

# ------------------------------------------------------------------------------
# 2. LLM Gateway & Provider Configuration
# ------------------------------------------------------------------------------
# Primary Provider options: 'gemini', 'ollama', or 'openrouter'
PRIMARY_PROVIDER=gemini
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini (Primary Multimodal & Reasoning Engine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini/gemini-2.5-flash

# Local Ollama (Zero-cost Local LLM Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/llama3.2:latest

# OpenRouter (Optional Cloud Fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# 3. Embeddings & Vector Store
# ------------------------------------------------------------------------------
# Embeddings: High-performance ONNX runtime (zero PyTorch overhead)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIRECTORY=./app/data/chroma_db

# ------------------------------------------------------------------------------
# 4. Redis Semantic Cache & Rate Limiting (Non-Critical / Graceful Failover)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 5. LangSmith Tracing & Observability
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=rag-app

# ------------------------------------------------------------------------------
# 6. Optional: GitHub MCP & API (For Codebase Audits)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 7. Frontend Authentication (Supabase)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
